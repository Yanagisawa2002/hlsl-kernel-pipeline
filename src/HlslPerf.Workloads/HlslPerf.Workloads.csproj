<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>EdwinLiu.HlslPerf.Workloads</PackageId>
    <Description>Reusable reduction, scan, transpose, compaction, histogram, and radix workloads for HlslPerf.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HlslPerf.Core/HlslPerf.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE.md" Pack="true" PackagePath="" />
    <None Include="../../kernels/*.hlsl" Pack="true" PackagePath="contentFiles/any/any/hlslperf/kernels/" />
    <None Include="../../kernels/include/hlslperf/*.hlsli" Pack="true" PackagePath="contentFiles/any/any/hlslperf/kernels/include/hlslperf/" />
    <None Include="../../third_party/**/*" Exclude="../../third_party/**/bin/**;../../third_party/**/obj/**" Pack="true" PackagePath="contentFiles/any/any/hlslperf/third_party/%(RecursiveDir)" />
    <None Include="../../manifests/*.json" Pack="true" PackagePath="contentFiles/any/any/hlslperf/manifests/" />
  </ItemGroup>
</Project>
